seliger-kamen.ru {
    reverse_proxy seliger-kamen-frontend:3000 {
        header_down X-Served-By {system.hostname}
        header_down X-Response-Time {time.now.unix}
    }
}

directus.seliger-kamen.ru {
    reverse_proxy seliger-kamen-directus:8055 {
        header_down X-Served-By {system.hostname}
        header_down X-Response-Time {time.now.unix}
    }

    handle /websocket {
        reverse_proxy seliger-kamen-directus:8055 {
            transport http {
                keepalive 30s
            }
        }
    }

    request_body {
        max_size 1GB
    }
}